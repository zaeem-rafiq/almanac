# Almanac — copy to `.env` and fill in. `.env` is gitignored and never committed.
# Loaded by `almanac/cli.py:load_env()`, which never overwrites a variable already set in the
# environment, so GitHub Actions secrets and host env win over this file in the cloud.

# --- Extraction: Google Vertex AI (almanac/extract.py) --------------------------------------
# The extractor and the note drafter are the only modules that call a model, and they call
# gemini-3.8-flash on Vertex. Credentials are Application Default Credentials, NOT an API key:
#   gcloud auth application-default login
# There is deliberately no ANTHROPIC_API_KEY here — the Anthropic path was retired at 038dbe6.

# Google Cloud project the Vertex client is bound to. Passed explicitly, so Almanac can never
# reach another project by way of `gcloud config set project`. Default: polygraph-hackathon
GOOGLE_CLOUD_PROJECT=

# Vertex region. Default: global
GOOGLE_CLOUD_LOCATION=

# Optional. Overrides the model id. Default: gemini-3.8-flash (almanac/extract.py DEFAULT_MODEL).
# Leave unset unless you are deliberately testing another model — temperature=0.0 and the pinned
# seed that make extraction reproducible are properties of this one.
# LLM_MODEL=

# Host and CI only. A Vercel function and a GitHub runner have no Application Default
# Credentials for google.auth.default() to find, and google-auth reads a PATH with no env var for
# inline JSON. almanac/gcp_credentials.py takes this (base64 or raw JSON), writes it to a 0600
# file and points GOOGLE_APPLICATION_CREDENTIALS at it. A no-op locally, where real ADC exists —
# leave it unset on your machine. Set it with `gh secret set` / `vercel env add`, never here.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Market rates: FMP (almanac/catalog.py) --------------------------------------------------
# The four market rates in facts/catalog.yaml are fetched by `python -m almanac rates --refresh`,
# which writes facts/rates.json. `catalog.refresh_rates()` is the only caller of FMP in the repo;
# every other module reads the written table. Each row carries the primary source it mirrors
# (treasury.gov / bls.gov / freddiemac.com / newyorkfed.org).
FMP_API_KEY=

# --- YouTube (almanac/youtube.py) ------------------------------------------------------------
# The one channel Almanac is authorised to read and, under the write guard, to write back to.
# OAuth itself is a separate `client_secret.json` + `token.json`, both gitignored.
ALMANAC_TEST_CHANNEL_ID=

# The write guard. `videos.update` runs ONLY when this is true AND the target channel id equals
# ALMANAC_TEST_CHANNEL_ID AND the CLI was given `--apply`. Anything else is a dry run that prints
# the diff. Leave it false unless you mean it.
ALMANAC_WRITE=false
