.env*
# ...but the template is the README's second instruction, so it must be tracked.
!.env.example
token.json
venv/
__pycache__/
*.pyc
client_secret.json
.DS_Store

# Scan output is a build artifact, regenerated by `almanac scan` on demand. `.gitkeep` stays
# tracked so the directory survives a fresh clone (A-00's prescribed layout).
reports/*
!reports/.gitkeep

# Rendered demo videos, regenerated by `scripts/render_slides.py`. Multi-MB binaries that are
# uploaded to the test channel rather than versioned.
renders/

# Eval extraction cache and scratch output (A-05). `results.md` / `results.json` ARE tracked —
# they are the table the README quotes; the cache is a build artifact.
evals/.cache/
